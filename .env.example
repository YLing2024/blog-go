# blog-go 环境变量样例（真实值一律占位，绝不入库；复制为部署用 EnvironmentFile 后按环境填写）。
# 键名与默认值逐条对齐旧实现 /root/proj/blog/server/src，示例中的域名一律用 example.com。

# ---- 管理端认证模式 ----
#   builtin —— 默认。自带账号 + cookie 会话（开箱即用，忽略外部 X-Auth-User）
#   sso     —— 关掉自带口令，管理端身份只认前置网关注入的 X-Auth-User（login/logout/me 一律 404）
AUTH_MODE=builtin

# ---- 监听（对外由 nginx 反代）----
HOST=127.0.0.1
PORT=19255

# ---- JWT 签名密钥：生产必须显式设置，勿用默认 dev-secret ----
JWT_SECRET=dev-secret

# ---- 数据库（仅 MySQL；详见 docs/DB.md）----
# 填连接参数，或直接给 DB_DSN（两者同时存在时以 DB_DSN 为准）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=blog
DB_USER=blog
DB_PASSWORD=
# DB_DSN=blog:REPLACE_WITH_PASSWORD@tcp(127.0.0.1:3306)/blog?charset=utf8mb4&parseTime=false&loc=Local

# ---- 上传目录（旧实现写死在 server/uploads）----
UPLOAD_DIR=./data/uploads

# ---- Admin 会话 Redis（第二兼容通道）：不可用时降级，不影响启动；支持逗号分隔多前缀 ----
ADMIN_REDIS_URL=redis://127.0.0.1:6379
ADMIN_REDIS_PREFIX=admin:session:

# ---- 公共站点（博客前台）基址，含协议，取消末尾斜杠后使用。
# preview-link 用它拼绝对地址；未配置时回退相对路径并打 warn ----
PUBLIC_SITE_URL=https://site.example.com

# ---- 草稿预览链接有效期（jsonwebtoken 时长写法：s/m/h/d/w 或纯秒数）----
PREVIEW_TTL=30m

# ---- 雪花 ID worker 号（仅多实例部署时需要区分）----
SNOWFLAKE_WORKER_ID=0

# ---- 首次启动创建管理员（已存在则忽略）----
BLOG_ADMIN_USER=admin
# BLOG_ADMIN_PASSWORD=        # 留空则随机 16 位并只打印一次
